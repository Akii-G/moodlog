        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_child(col)
        self.set_child(scroll)
        self.update_status()
        self._timer = GLib.timeout_add_seconds(3, self.update_status)
        self.connect("close-request", self.on_close)

    def on_close(self, *_):
        GLib.source_remove(self._timer)
        return False

    def on_copy(self, _btn, value):
        self.get_clipboard().set_content(Gdk.ContentProvider.new_for_value(value))

    def on_switch(self, _switch, state):
        if self._setting:
            return False
        systemctl("daemon-reload")
        ok, err = systemctl("enable" if state else "disable", "--now", SERVICE)
        if not ok:
            self.error = ("Could not %s the receiver (%s). You can also start it by hand "
                          "in a terminal: moodlog --sync-server" % (
                              "start" if state else "stop", err or "systemctl failed"))
        else:
            self.error = ""
        GLib.idle_add(self.update_status)
        return False

    def update_status(self):
        active, _ = systemctl("is-active", "--quiet", SERVICE)
        self._setting = True
        self.switch.set_active(active)
        self._setting = False
        lines = []
        if getattr(self, "error", ""):
            lines.append(self.error)
        lines.append("The receiver is running." if active else "The receiver is off.")
        try:
            with open(sync_status_path(), encoding="utf-8") as f:
                stamp, _, message = f.read().strip().partition("\n")
            lines.append("Last sync attempt %s. %s" % (stamp, message.replace("\n", " ")))
        except OSError:
            lines.append("Nothing received from the phone yet.")
        self.status.set_text("\n".join(lines))
        return True


