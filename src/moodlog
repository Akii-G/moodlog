    # -- state

    def period(self):
        """(start, end) dates of the period the charts show; None = open."""
        cur = self.cursor
        if self.range_mode == "month":
            last = calendar.monthrange(cur.year, cur.month)[1]
            return cur.replace(day=1), cur.replace(day=last)
        if self.range_mode == "year":
            return dt.date(cur.year, 1, 1), dt.date(cur.year, 12, 31)
        return None, None

    def period_moods(self):
        """(date, level) for each day with a mood in the period on screen."""
        start, end = self.period()
        return self.store.moods(start, end)

    def period_entries(self):
        """(date, time, mood) for every single entry in the period on screen."""
        start, end = self.period()
        return self.store.timed(start, end)

    def shift(self, step, charts=False):
        cur = self.cursor
        if charts and self.range_mode == "year":
            cur = cur.replace(year=cur.year + step)
        else:
            index = cur.year * 12 + cur.month - 1 + step
            cur = dt.date(index // 12, index % 12 + 1, 1)
        today = dt.date.today()
        if (cur.year, cur.month) > (today.year, today.month):
            cur = today.replace(day=1)
        self.cursor = cur
        self.refresh()

    def select_day(self, day, entry=None):
        self.flush()
        self.selected = day
        self.cursor = day.replace(day=1)
        self.load_selected(entry)
        self.refresh()

    def load_selected(self, entry=None):
        """Show a day. Today opens ready for a new entry; a past day opens its last entry."""
        day, today = self.selected, dt.date.today()
        items = self.store.entries(day)
        if entry is not None and any(e is entry for e in items):
            self.current = entry
        elif day == today or not items:
            self.current = None
        else:
            self.current = items[-1]
        if day == today:
            title = "Today"
        elif day == today - dt.timedelta(days=1):
            title = "Yesterday"
        else:
            title = day.strftime("%A")
        self.day_label.set_text("%s, %s" % (title, day.strftime("%-d %B %Y")))
        self.rebuild_day_events()
        self.load_editor()
        self.rebuild_entries()

    def load_editor(self):
        """Fill the editor from the current entry (or blank it for a new one)."""
        entry = self.current
        self._loading = True
        for m, btn in self.face_buttons.items():
            btn.set_active(bool(entry) and m == entry[1])
        self.note_view.get_buffer().set_text(entry[2] if entry else "")
        if entry:
            self.time_entry.set_text(entry[0])
        elif self.selected == dt.date.today():
            self.time_entry.set_text(dt.datetime.now().strftime("%H:%M"))
        else:
            self.time_entry.set_text("")
        self.time_entry.remove_css_class("error")
        self._time_touched = False
        self.saved_label.set_text("")
        self._loading = False
        self.update_mode()

    def update_mode(self):
        editing = self.current is not None
        if editing:
            self.mode_label.set_text("Editing this entry")
        elif self.selected == dt.date.today():
            self.mode_label.set_text("New entry: how do you feel now?")
        else:
            self.mode_label.set_text("New entry: how was this day?")
        self.delete_btn.set_visible(editing)
        self.new_btn.set_visible(editing)

    def read_time(self):
        """Time typed in the field: 'HH:MM', '' for none, or None if it is not a time."""
        value = self.time_entry.get_text().strip()
        loose = re.fullmatch(r"(\d{1,2})[:.,](\d{2})", value)
        if loose:
            value = "%02d:%s" % (int(loose.group(1)), loose.group(2))
        return value if (not value or TIME_RE.match(value)) else None

    def current_note(self):
        buf = self.note_view.get_buffer()
        return buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False)

    def current_mood(self):
        for m, btn in self.face_buttons.items():
            if btn.get_active():
                return m
        return 0

    def on_time_changed(self, _entry):
        if self._loading:
            return
        self._time_touched = True
        value = self.read_time()
        if value is None:
            self.time_entry.add_css_class("error")
            return
        self.time_entry.remove_css_class("error")

    def apply_time(self, *_args):
        """Give the entry being edited the time in the field, once typing is finished."""
        if self._loading or self.current is None:
            return
        value = self.read_time()
        if value is None:  # not a time: put the entry's own time back
            self._loading = True
            self.time_entry.set_text(self.current[0])
            self.time_entry.remove_css_class("error")
            self._loading = False
        elif self.current[0] != value:
            self.current[0] = value
            self.store.resort(self.selected)
            self.schedule_save()
            self.rebuild_entries()

    def on_face_toggled(self, btn, mood):
        if self._loading:
            return
        if btn.get_active():
            self._loading = True
            for m, other in self.face_buttons.items():
                if m != mood:
                    other.set_active(False)
            self._loading = False
        self.commit()
        self.rebuild_entries()
        self.refresh()

    def on_note_changed(self, _buf):
        if self._loading:
            return
        self.commit()
        self.calendar.queue_draw()

    def on_entry_row(self, _list, row):
        self.apply_time()
        self.current = row.entry
        self.load_editor()
        GLib.idle_add(self.rebuild_entries)

    def on_new(self, _btn):
        self.apply_time()
        self.current = None
        self.load_editor()
        self.rebuild_entries()

    def on_delete(self, _btn):
        if self.current is None:
            return
        self.store.remove(self.selected, self.current)
        self.current = None
        self.load_editor()
        self.rebuild_entries()
        self.schedule_save()
        self.refresh()

    def commit(self):
        """Write the editor into the store: creates the entry on first input."""
        mood, note, day = self.current_mood(), self.current_note(), self.selected
        if self.current is None:
            if not mood and not note.strip():
                return
            value = self.read_time() or ""
            if day == dt.date.today() and not self._time_touched:
                value = dt.datetime.now().strftime("%H:%M")
            self.current = self.store.add(day, value, mood, note)
            self._loading = True
            self.time_entry.set_text(self.current[0])
            self.time_entry.remove_css_class("error")
            self._loading = False
            self.update_mode()
        else:
            self.current[1], self.current[2] = mood, note
            if not mood and not note.strip():
                self.store.remove(day, self.current)
                self.current = None
                self.update_mode()
        self.schedule_save()

    def rebuild_entries(self):
        """List of the selected day's entries, above the editor."""
        child = self.entry_list.get_first_child()
        while child:
            self.entry_list.remove(child)
            child = self.entry_list.get_first_child()
        items = self.store.entries(self.selected)
        for entry in items:
            time, mood, note = entry
            row = Gtk.ListBoxRow()
            row.entry = entry
            row.set_tooltip_text("Click to edit this entry")
            box = Gtk.Box(spacing=10)
            for side in ("top", "bottom"):
                getattr(box, "set_margin_" + side)(6)
            for side in ("start", "end"):
                getattr(box, "set_margin_" + side)(10)
            when = Gtk.Label(label=time or "––:––", xalign=0)
            when.set_width_chars(5)
            when.add_css_class("heading" if entry is self.current else "dim-label")
            box.append(when)
            if mood:
                box.append(FaceIcon(mood, 26, badge=True))
                name = Gtk.Label(label=MOOD_NAMES[mood], xalign=0)
                box.append(name)
            snippet = Gtk.Label(label=" ".join(note.split()), xalign=0, hexpand=True)
            snippet.set_ellipsize(Pango.EllipsizeMode.END)
            snippet.add_css_class("dim-label")
            box.append(snippet)
            row.set_child(box)
            self.entry_list.append(row)
        self.entry_scroll.set_visible(bool(items))
        return False

    def schedule_save(self):
        if self._save_id:
            GLib.source_remove(self._save_id)
        self._save_id = GLib.timeout_add(500, self.flush)

    def flush(self):
        self.apply_time()
        if self._save_id:
            GLib.source_remove(self._save_id)
            self._save_id = 0
            try:
                self.store.save()
                self.saved_label.set_text("Saved")
            except OSError as err:
                self.saved_label.set_text("Could not save: %s" % err)
            self.sync_widget()
            self.rebuild_entries()
        return False

    def on_close(self, *_):
        self.flush()
        return False

    def on_range_changed(self, drop, _param):
        self.range_mode = ("month", "year", "all")[drop.get_selected()]
        self.refresh()

    def on_metric_changed(self, drop, _param):
        keys = self._metric_keys or []
        if self._loading or not keys or drop.get_selected() >= len(keys):
            return
        self.health_metric = keys[drop.get_selected()]
        self.refresh_health()

    def sync_widget(self):
        """Exchange moods with the Gridgets widget; True if Moodlog's entries changed."""
        if not self.link.active():
            return False
        try:
            changed = self.link.reconcile_all()
            if changed:
                self.store.save()
        except OSError:
            return False
        return changed

    def on_link_toggled(self, switch, _param):
        self.link.enabled = switch.get_active()
        self.link.save_state()
        if self.sync_widget():
            self.show_selected_mood()
            self.refresh()

    def show_selected_mood(self):
        """Entries were changed from outside the editor (the desktop widget)."""
        if self.current is not None and not any(
                e is self.current for e in self.store.entries(self.selected)):
            self.current = None
            self.load_editor()
        self.rebuild_entries()

    def poll_health(self):
        if not self._save_id and self.link.active() and self.link.changed_on_disk():
            if self.sync_widget():
                self.show_selected_mood()
                self.refresh()
        if self.health.changed_on_disk():
            self.health.load()
            if self.stack.get_visible_child_name() == "charts":
                self.refresh_charts()
        return True

    def insight(self):
        """Plain-language comparison of mood on higher vs lower days of the metric."""
        metric = self.health_metric
        title = metric_info(metric)[0].lower()
        start, end = self.period()
        values = dict(self.health.series(metric, start, end))
        pairs = [(mood, values[day]) for day, mood in self.period_moods() if day in values]
        if len(pairs) < 8:
            return ("%d day%s in this period have both a mood and %s data. With 8 or more, "
                    "Moodlog compares your mood on higher and lower days." % (
                        len(pairs), "" if len(pairs) == 1 else "s", title))
        ordered = sorted(v for _m, v in pairs)
        median = ordered[len(ordered) // 2]
        high = [m for m, v in pairs if v >= median]
        low = [m for m, v in pairs if v < median]
        if len(high) < 3 or len(low) < 3:
            return "Your %s barely changed in this period, so there is nothing to compare yet." % title
        a, b = sum(high) / len(high), sum(low) / len(low)
        cut = format_value(metric, median)
        if abs(a - b) < 0.25:
            return ("Your mood was about the same on days with more and less %s: %.1f at %s or "
                    "more, %.1f below (%d days compared)." % (title, a, cut, b, len(pairs)))
        return ("On days with %s at %s or more, your average mood was %.1f. On days below that "
                "it was %.1f (%d days compared). This shows a pattern in your data, not a cause."
                % (title, cut, a, b, len(pairs)))

    def refresh_health(self):
        keys = self.health.metrics()
        if keys != self._metric_keys:
            self._metric_keys = keys
            if self.health_metric not in keys:
                self.health_metric = keys[0] if keys else None
            self._loading = True
            self.metric_drop.set_model(Gtk.StringList.new([metric_info(k)[0] for k in keys]))
            if keys:
                self.metric_drop.set_selected(keys.index(self.health_metric))
            self._loading = False
        self.metric_drop.set_visible(bool(keys))
        self.health_chart.set_visible(bool(keys))
        if keys:
            self.health_text.set_text(self.insight())
        else:
            self.health_text.set_text(
                "No health data yet. Use Phone sync in the title bar to bring in sleep, steps "
                "and heart rate from your iPhone, and compare them with your mood here.")
        self.health_chart.queue_draw()

    def on_note_row(self, _list, row):
        self.select_day(row.day, row.entry)
        self.stack.set_visible_child_name("log")

    def export_name(self, kind="csv"):
        return "moodlog-export-%s.%s" % (dt.date.today().isoformat(), kind)

    def on_export(self, kind="csv"):
        self.flush()
        self._export_kind = kind
        title = "Export to a spreadsheet" if kind == "xlsx" else "Export to CSV"
        if hasattr(Gtk, "FileDialog"):  # GTK 4.10 and newer
            dialog = Gtk.FileDialog(title=title, initial_name=self.export_name(kind))
            dialog.save(self, None, self._export_done_new)
            return
        dialog = Gtk.FileChooserNative.new(title, self, Gtk.FileChooserAction.SAVE,
                                           "Export", "Cancel")
        dialog.set_current_name(self.export_name(kind))
        dialog.connect("response", self._export_done_old)
        self._chooser = dialog  # keep a reference while it is open
        dialog.show()

    def _export_done_new(self, dialog, result):
        try:
            gfile = dialog.save_finish(result)
        except GLib.Error:
            return  # cancelled
        if gfile:
            self.write_export(gfile.get_path(), self._export_kind)

    def _export_done_old(self, dialog, response):
        if response == Gtk.ResponseType.ACCEPT and dialog.get_file():
            self.write_export(dialog.get_file().get_path(), self._export_kind)
        self._chooser = None

    def write_export(self, path, kind="csv"):
        if not path:
            return
        if not path.lower().endswith("." + kind):
            path += "." + kind
        writer = export_xlsx if kind == "xlsx" else export_csv
        try:
            count = writer(path, self.store, self.events, self.health)
            message = "Exported %d day%s to %s" % (count, "" if count == 1 else "s",
                                                   os.path.basename(path))
        except ExportError as err:
            message = str(err)
        except OSError as err:
            message = "Could not export: %s" % (err.strerror or err)
        self.saved_label.set_text(message)
        if hasattr(Gtk, "AlertDialog"):  # GTK 4.10 and newer
            Gtk.AlertDialog(message=message).show(self)

    def open_data_folder(self, _btn):
        self.flush()
        Gio.AppInfo.launch_default_for_uri(GLib.filename_to_uri(data_dir(), None), None)

    # -- refresh

    def redraw_all(self):
        def walk(widget):
            if isinstance(widget, Gtk.DrawingArea):
                widget.queue_draw()
            child = widget.get_first_child()
            while child:
                walk(child)
                child = child.get_next_sibling()
        walk(self)

    def streak(self):
        day = dt.date.today()
        if not self.store.day_level(day):
            day -= dt.timedelta(days=1)
        count = 0
        while self.store.day_level(day):
            count += 1
            day -= dt.timedelta(days=1)
        return count

    def refresh(self):
        cur, today = self.cursor, dt.date.today()
        at_now = (cur.year, cur.month) >= (today.year, today.month)
        self.month_label.set_text("%s %d" % (MONTHS[cur.month - 1], cur.year))
        self.log_next.set_sensitive(not at_now)
        last = calendar.monthrange(cur.year, cur.month)[1]
        month_moods = [m for _d, m in self.store.moods(cur, cur.replace(day=last))]
        if month_moods:
            avg = sum(month_moods) / len(month_moods)
            self.month_summary.set_text("%d day%s logged this month · average %.1f (%s)" % (
                len(month_moods), "" if len(month_moods) == 1 else "s", avg,
                MOOD_NAMES[to_level(avg)].lower()))
        else:
            self.month_summary.set_text("Nothing logged this month yet")
        self.calendar.queue_draw()

        visible = self.stack.get_visible_child_name()
        if visible == "charts":
            self.refresh_charts()
        elif visible == "notes":
            self.refresh_notes()
        elif visible == "events":
            self.refresh_events()

    def refresh_charts(self):
        cur, today, mode = self.cursor, dt.date.today(), self.range_mode
        if mode == "month":
            self.period_label.set_text("%s %d" % (MONTHS[cur.month - 1], cur.year))
            at_now = (cur.year, cur.month) >= (today.year, today.month)
            days_total = calendar.monthrange(cur.year, cur.month)[1]
            if at_now:
                days_total = today.day
            self.trend_title.set_text("Mood day by day")
        elif mode == "year":
            self.period_label.set_text(str(cur.year))
            at_now = cur.year >= today.year
            end = today if at_now else dt.date(cur.year, 12, 31)
            days_total = (end - dt.date(cur.year, 1, 1)).days + 1
            self.trend_title.set_text("Average mood by month")
        else:
            self.period_label.set_text("All time")
            at_now = True
            first = min(self.store.days) if self.store.days else today
            days_total = (today - first).days + 1
            self.trend_title.set_text("Average mood by month")
        self.chart_prev.set_visible(mode != "all")
        self.chart_next.set_visible(mode != "all")
        self.chart_next.set_sensitive(not at_now)

        moods = [m for _d, m in self.period_moods()]
        value, sub = self.tiles["avg"]
        if moods:
            avg = sum(moods) / len(moods)
            value.set_text("%.1f" % avg)
            sub.set_text("%s, on a 1–5 scale" % MOOD_NAMES[to_level(avg)])
        else:
            value.set_text("–")
            sub.set_text("nothing logged")
        value, sub = self.tiles["days"]
        value.set_text(str(len(moods)))
        sub.set_text("of %d day%s so far" % (days_total, "" if days_total == 1 else "s"))
        value, sub = self.tiles["common"]
        if moods:
            best = max(range(1, 6), key=lambda m: (moods.count(m), m))
            value.set_text(MOOD_NAMES[best])
            sub.set_text("%d day%s" % (moods.count(best), "" if moods.count(best) == 1 else "s"))
        else:
            value.set_text("–")
            sub.set_text("")
        value, sub = self.tiles["streak"]
        streak = self.streak()
        value.set_text("%d day%s" % (streak, "" if streak == 1 else "s"))
        sub.set_text("logged in a row, up to today")
        for chart in (self.trend, self.counts, self.weekdays, self.hours):
            chart.queue_draw()
        self.refresh_health()

    def refresh_notes(self):
        child = self.notes_list.get_first_child()
        while child:
            self.notes_list.remove(child)
            child = self.notes_list.get_first_child()
        query = self.search.get_text().strip().lower()
        shown = 0
        for day in sorted(self.store.days, reverse=True):
            for entry in reversed(self.store.entries(day)):
                time, mood, note = entry
                if not note.strip() or (query and query not in note.lower()):
                    continue
                row = Gtk.ListBoxRow()
                row.day = day
                row.entry = entry
                box = Gtk.Box(spacing=12)
                for side in ("top", "bottom", "start", "end"):
                    getattr(box, "set_margin_" + side)(12)
                if mood:
                    icon = FaceIcon(mood, 34, badge=True)
                    icon.set_valign(Gtk.Align.START)
                    icon.set_tooltip_text(MOOD_NAMES[mood])
                    box.append(icon)
                else:
                    spacer = Gtk.Box()
                    spacer.set_size_request(34, 34)
                    box.append(spacer)
                when = day.strftime("%A, %-d %B %Y")
                if time:
                    when += " · " + time
                if mood:
                    when += " · " + MOOD_NAMES[mood]
                head = Gtk.Label(label=when, xalign=0)
                head.add_css_class("heading")
                body = Gtk.Label(label=note.strip(), xalign=0, wrap=True)
                body.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
                body.set_selectable(False)
                textbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, hexpand=True)
                textbox.append(head)
                textbox.append(body)
                box.append(textbox)
                row.set_child(box)
                self.notes_list.append(row)
                shown += 1
        self.notes_list.set_visible(shown > 0)
        self.notes_empty.set_visible(shown == 0)
        if query:
            self.notes_empty.set_text("No notes match “%s”." % self.search.get_text().strip())
        else:
            self.notes_empty.set_text(
                "No notes yet.\nAdd a few words when you log a mood and they will show up here.")


class App(Adw.Application):
    def __init__(self, page=None):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.page = page

    def do_activate(self):
        win = self.get_active_window() or Window(self, self.page)
        win.present()


def main(argv):
    if "--version" in argv:
        print("Moodlog", VERSION)
        return 0
    if "--sync-server" in argv:
        return run_sync_server()
    if "--export" in argv:
        i = argv.index("--export")
        if i + 1 >= len(argv):
            print("usage: moodlog --export FILE.csv|FILE.xlsx", file=sys.stderr)
            return 2
        writer = export_xlsx if argv[i + 1].lower().endswith(".xlsx") else export_csv
        try:
            count = writer(argv[i + 1], Store(), EventStore(), HealthStore())
        except ExportError as err:
            print(err, file=sys.stderr)
            return 1
        print("Exported %d days to %s" % (count, argv[i + 1]))
        return 0
    page = None
    for arg in argv[1:]:
        if arg.startswith("--page="):
            page = arg.split("=", 1)[1]
    return App(page).run([argv[0]])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
