class CalendarView(Canvas):
    HEAD = 26
    GAP = 6

    def __init__(self, win):
        super().__init__(380, 380)
        self.win = win
        self.set_hexpand(True)
        self.set_vexpand(True)
        self.cells = []
        click = Gtk.GestureClick.new()
        click.connect("pressed", self._on_click)
        self.add_controller(click)

    def _on_click(self, _gesture, _n, x, y):
        for cx, cy, cw, ch, day in self.cells:
            if cx <= x <= cx + cw and cy <= y <= cy + ch:
                if day <= dt.date.today():
                    self.win.select_day(day)
                return

    def draw(self, cr, w, h, th):
        self.cells = []
        win = self.win
        year, month = win.cursor.year, win.cursor.month
        weeks = calendar.Calendar(firstweekday=0).monthdatescalendar(year, month)
        gap = self.GAP
        size = min((w - 6 * gap) / 7, (h - self.HEAD - (len(weeks) - 1) * gap) / len(weeks), 72)
        size = max(size, 20)
        x0 = (w - (7 * size + 6 * gap)) / 2
        for i, name in enumerate(WEEKDAYS):
            text(cr, self, name, x0 + i * (size + gap) + size / 2, 4, 9, th["muted"], ax=0.5)
        today = dt.date.today()
        for r, week in enumerate(weeks):
            for c, day in enumerate(week):
                if day.month != month:
                    continue
                x = x0 + c * (size + gap)
                y = self.HEAD + r * (size + gap)
                mood = win.store.day_level(day)
                moods = [e[1] for e in win.store.entries(day) if e[1]]
                future = day > today
                self.cells.append((x, y, size, size, day))
                if len(moods) > 1:
                    self.draw_grid(cr, x, y, size, day, moods, th)
                    self.draw_marks(cr, x, y, size, day, today, th)
                    continue
                rounded_rect(cr, x, y, size, size, th["radius"])
                if mood:
                    src(cr, th["moods"][mood])
                    cr.fill()
                    ink = FACE_INK[mood]
                    draw_face(cr, x + size / 2, y + size * 0.57, size * 0.24, mood, ink,
                              outline=False)
                else:
                    src(cr, th["ink"], 0.05 if not future else 0.02)
                    cr.fill()
                    ink = th["ink"]
                text(cr, self, str(day.day), x + 7, y + 4, 8.5, ink, bold=(day == today),
                     alpha=0.35 if future else (0.9 if mood else 0.6))
                if win.store.has_note(day):  # small corner dot = this day has a note
                    src(cr, ink, 0.85)
                    cr.arc(x + size - 9, y + 10, 2.6, 0, 2 * math.pi)
                    cr.fill()
                self.draw_marks(cr, x, y, size, day, today, th)

    MAX_TILES = 9
    HEADER = 15

    def draw_grid(self, cr, x, y, size, day, moods, th):
        """A day with several entries: a strip with the date, then one tile per entry."""
        cr.save()
        rounded_rect(cr, x, y, size, size, th["radius"])
        cr.clip()
        src(cr, th["ink"], 0.05)
        cr.rectangle(x, y, size, size)
        cr.fill()
        today = dt.date.today()
        text(cr, self, str(day.day), x + 7, y + 2, 8.5, th["ink"], bold=(day == today), alpha=0.75)
        if self.win.store.has_note(day):
            src(cr, th["ink"], 0.7)
            cr.arc(x + size - 9, y + 8, 2.4, 0, 2 * math.pi)
            cr.fill()
        shown = moods if len(moods) <= self.MAX_TILES else moods[:self.MAX_TILES - 1]
        extra = len(moods) - len(shown)
        tiles = len(shown) + (1 if extra else 0)
        cols = math.ceil(math.sqrt(tiles))
        rows = math.ceil(tiles / cols)
        gap = 2
        gx, gy = x, y + self.HEADER
        gw, gh = size, size - self.HEADER
        tw = (gw - gap * (cols - 1)) / cols
        th_ = (gh - gap * (rows - 1)) / rows
        for i in range(tiles):
            r, c = divmod(i, cols)
            tx, ty = gx + c * (tw + gap), gy + r * (th_ + gap)
            cr.rectangle(tx, ty, tw, th_)
            if i < len(shown):
                src(cr, th["moods"][shown[i]])
                cr.fill()
                radius = min(tw, th_) * 0.3
                if radius >= 4.5:
                    draw_face(cr, tx + tw / 2, ty + th_ / 2, radius, shown[i],
                              FACE_INK[shown[i]], outline=False)
            else:
                src(cr, th["ink"], 0.12)
                cr.fill()
                text(cr, self, "+%d" % extra, tx + tw / 2, ty + th_ / 2, 7.5, th["ink"],
                     ax=0.5, ay=0.5, alpha=0.8)
        cr.restore()

    def draw_marks(self, cr, x, y, size, day, today, th):
        """Today and selection outlines, and the hover text, for any cell."""
        win = self.win
        events = win.events.on(day)
        if events:
            draw_event_badge(cr, x + 10, y + size - 10, 7.5, th)
        if day == today and day != win.selected:
            rounded_rect(cr, x + 0.75, y + 0.75, size - 1.5, size - 1.5, th["radius"])
            src(cr, th["ink"], 0.45)
            cr.set_line_width(1.5)
            cr.stroke()
        if day == win.selected:
            rounded_rect(cr, x - 2.5, y - 2.5, size + 5, size + 5, th["radius"] + 2)
            src(cr, th["ink"])
            cr.set_line_width(2)
            cr.stroke()
        if day <= today or events:
            title = day.strftime("%a %-d %b")
            tip = win.store.describe_day(day, title) if day <= today else title
            for event in events:
                tip += "\nEvent \u2014 %s: %s" % (EVENT_LABELS[event[1]], event[2])
            self.hits.append((x, y, size, size, tip))


