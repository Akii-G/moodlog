def run_sync_server():
    """`moodlog --sync-server`: receive health data from the phone over the local network.

    It only accepts data (POST with the secret token). It never sends any data back.
    """
    import http.server

    cfg = sync_config()
    token = cfg["token"]

    class Handler(http.server.BaseHTTPRequestHandler):
        server_version = "Moodlog/" + VERSION

        def reply(self, code, message):
            body = (message + "\n").encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            self.reply(200, "Moodlog sync is running. Send health data with POST /health.")

        def authorised(self):
            given = self.headers.get("Authorization", "")
            given = given[7:] if given.lower().startswith("bearer ") else given
            given = given or self.headers.get("X-Token", "")
            if not given and "?" in self.path:
                import urllib.parse
                given = (urllib.parse.parse_qs(self.path.split("?", 1)[1]).get("token") or [""])[0]
            return hmac.compare_digest(given.strip().encode(), token.encode())

        def do_POST(self):
            if not self.authorised():
                self.reply(401, "Wrong or missing token. Copy it again from Moodlog > Phone sync.")
                return
            try:
                length = int(self.headers.get("Content-Length", "0"))
            except ValueError:
                length = 0
            if not 0 < length <= 5 * 1024 * 1024:
                self.reply(400, "Empty request (or larger than 5 MB).")
                return
            body = self.rfile.read(length)
            incoming, problems = parse_payload(body)
            store = HealthStore()
            stored = store.merge(incoming)
            if stored:
                store.save()
            parts = ["%s for %d day%s" % (metric_info(m)[0].lower(), n, "" if n == 1 else "s")
                     for m, n in stored.items()]
            message = ("OK. Stored " + ", ".join(parts) + ".") if parts else \
                "Nothing stored: no health values found in what was sent."
            if problems:
                key = next((p for p in problems if p.startswith("sleep times")), problems[0])
                message += "\n%d line(s) skipped. %s" % (len(problems), key)
            stamp = dt.datetime.now().strftime("%Y-%m-%d %H:%M")
            try:
                with open(sync_status_path(), "w", encoding="utf-8") as f:
                    f.write("%s\n%s\n" % (stamp, message))
            except OSError:
                pass
            self.reply(200 if parts else 422, message)

        def log_message(self, fmt, *args):
            sys.stderr.write("moodlog-sync: %s\n" % (fmt % args))

    server = http.server.ThreadingHTTPServer(("0.0.0.0", int(cfg["port"])), Handler)
    print("Moodlog sync listening on port %d" % cfg["port"], flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


