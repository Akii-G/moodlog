def src(cr, hex_color, alpha=1.0):
    h = hex_color.lstrip("#")
    cr.set_source_rgba(int(h[0:2], 16) / 255, int(h[2:4], 16) / 255,
                       int(h[4:6], 16) / 255, alpha)


def rounded_rect(cr, x, y, w, h, r):
    r = max(0, min(r, w / 2, h / 2))
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def bar_right(cr, x, y, w, h, r=4):
    """Horizontal bar: square at the baseline (left), rounded data end."""
    r = max(0, min(r, w, h / 2))
    cr.new_sub_path()
    cr.move_to(x, y)
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.line_to(x, y + h)
    cr.close_path()


def bar_up(cr, x, y, w, h, r=4):
    """Column: square at the baseline (bottom), rounded top."""
    r = max(0, min(r, w / 2, h))
    cr.new_sub_path()
    cr.move_to(x, y + h)
    cr.line_to(x, y + r)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.line_to(x + w, y + h)
    cr.close_path()


def text(cr, widget, s, x, y, size=10, color="#000000", bold=False,
         ax=0.0, ay=0.0, alpha=1.0):
    """Draw text; (ax, ay) is the anchor: 0 = left/top, 0.5 = centre, 1 = right/bottom."""
    layout = widget.create_pango_layout(s)
    desc = Pango.FontDescription()
    desc.set_size(int(size * Pango.SCALE))
    if bold:
        desc.set_weight(Pango.Weight.BOLD)
    layout.set_font_description(desc)
    w, h = layout.get_pixel_size()
    src(cr, color, alpha)
    cr.move_to(x - w * ax, y - h * ay)
    PangoCairo.show_layout(cr, layout)
    return w, h


def draw_face(cr, cx, cy, r, mood, ink, outline=True, alpha=1.0):
    """A simple line-drawn face for moods 1 (awful) to 5 (great)."""
    lw = max(1.4, r * 0.13)
    cr.set_line_width(lw)
    cr.set_line_cap(1)  # round
    src(cr, ink, alpha)
    if outline:
        cr.arc(cx, cy, r, 0, 2 * math.pi)
        cr.stroke()
    ex, ey, er = r * 0.36, r * 0.20, max(1.0, r * 0.11)
    for sx in (-1, 1):
        cr.arc(cx + sx * ex, cy - ey, er, 0, 2 * math.pi)
        cr.fill()
    w, y = r * 0.46, cy + r * 0.30
    if mood == 1:
        for sx in (-1, 1):  # worried brows
            cr.move_to(cx + sx * (ex + r * 0.18), cy - ey - r * 0.22)
            cr.line_to(cx + sx * (ex - r * 0.14), cy - ey - r * 0.36)
            cr.stroke()
        cr.move_to(cx - w, y + r * 0.22)
        cr.curve_to(cx - w * 0.5, y - r * 0.26, cx + w * 0.5, y - r * 0.26,
                    cx + w, y + r * 0.22)
        cr.stroke()
    elif mood == 2:
        cr.move_to(cx - w, y + r * 0.12)
        cr.curve_to(cx - w * 0.5, y - r * 0.12, cx + w * 0.5, y - r * 0.12,
                    cx + w, y + r * 0.12)
        cr.stroke()
    elif mood == 3:
        cr.move_to(cx - w, y + r * 0.04)
        cr.line_to(cx + w, y + r * 0.04)
        cr.stroke()
    elif mood == 4:
        cr.move_to(cx - w, y - r * 0.08)
        cr.curve_to(cx - w * 0.5, y + r * 0.24, cx + w * 0.5, y + r * 0.24,
                    cx + w, y - r * 0.08)
        cr.stroke()
    elif mood == 5:
        cr.move_to(cx - w * 1.1, y - r * 0.14)
        cr.line_to(cx + w * 1.1, y - r * 0.14)
        cr.curve_to(cx + w * 0.8, y + r * 0.44, cx - w * 0.8, y + r * 0.44,
                    cx - w * 1.1, y - r * 0.14)
        cr.close_path()
        cr.fill_preserve()
        cr.set_line_join(1)
        cr.stroke()


def draw_mood_badge(cr, cx, cy, r, mood, th):
    """Filled circle in the mood colour with the face on top."""
    src(cr, th["moods"][mood])
    cr.arc(cx, cy, r, 0, 2 * math.pi)
    cr.fill()
    draw_face(cr, cx, cy, r * 0.82, mood, FACE_INK[mood], outline=False)


class Canvas(Gtk.DrawingArea):
    """Drawing area with per-mark hover tooltips."""

    def __init__(self, width=-1, height=-1):
        super().__init__()
        self.set_content_width(max(width, 0))
        self.set_content_height(max(height, 0))
        self.hits = []  # (x, y, w, h, tooltip text)
        self.set_has_tooltip(True)
        self.connect("query-tooltip", self._on_tooltip)
        self.set_draw_func(self._draw)

    def _draw(self, _area, cr, w, h):
        self.hits = []
        self.draw(cr, w, h, theme())

    def draw(self, cr, w, h, th):
        pass

    def hit(self, x, y):
        for hx, hy, hw, hh, tip in reversed(self.hits):
            if hx <= x <= hx + hw and hy <= y <= hy + hh:
                return hx, hy, hw, hh, tip
        return None

    def _on_tooltip(self, _w, x, y, _keyboard, tooltip):
        found = self.hit(x, y)
        if not found or not found[4]:
            return False
        rect = Gdk.Rectangle()
        rect.x, rect.y = int(found[0]), int(found[1])
        rect.width, rect.height = max(1, int(found[2])), max(1, int(found[3]))
        tooltip.set_tip_area(rect)
        tooltip.set_text(found[4])
        return True


