        self.error.add_css_class("error")
        self.error.set_visible(False)
        col.append(self.error)

        buttons = Gtk.Box(spacing=8)
        if event:
            delete = Gtk.Button(label="Delete")
            delete.add_css_class("destructive-action")
            delete.connect("clicked", self.on_delete)
            buttons.append(delete)
        spacer = Gtk.Box(hexpand=True)
        buttons.append(spacer)
        cancel = Gtk.Button(label="Cancel")
        cancel.connect("clicked", lambda *_: self.close())
        save = Gtk.Button(label="Save")
        save.add_css_class("suggested-action")
        save.connect("clicked", self.on_save)
        buttons.append(cancel)
        buttons.append(save)
        col.append(buttons)
        self.set_child(col)
        self.title_entry.grab_focus()

    def fail(self, message):
        self.error.set_text(message)
        self.error.set_visible(True)

    def on_save(self, *_):
        raw = self.date_entry.get_text().strip()
        try:
            day = dt.date.fromisoformat(raw)
        except ValueError:
            self.fail("Write the date as year-month-day, for example %s." % dt.date.today().isoformat())
            return
        title = " ".join(self.title_entry.get_text().split())
        if not title:
            self.fail("Give the event a short title.")
            return
        kind = EVENT_KINDS[self.kind_drop.get_selected()][0]
        buf = self.note_view.get_buffer()
        note = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False).strip()
        events = self.win.events
        if self.event:
            self.event[:] = [day, kind, title, note]
            events.sort()
        else:
            events.add(day, kind, title, note)
        if self.win.save_events():
            self.close()
        else:
            self.fail("Could not save the event to events.csv.")

    def on_delete(self, *_):
        self.win.events.remove(self.event)
        if self.win.save_events():
            self.close()
        else:
            self.fail("Could not save the change to events.csv.")


