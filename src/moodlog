class WeekdayChart(Canvas):
    """Average mood for each day of the week."""

    def __init__(self, win):
        super().__init__(-1, 214)
        self.win = win
        self.set_hexpand(True)

    def draw(self, cr, w, h, th):
        data = self.win.period_moods()
        if not data:
            no_data(cr, self, w, h, th)
            return
        by_day = {i: [] for i in range(7)}
        for day, mood in data:
            by_day[day.weekday()].append(mood)
        left, right, top, bottom = 26, 8, 20, 26
        pw, ph = w - left - right, h - top - bottom
        cr.set_line_width(1)
        for level in range(0, 6):
            y = round(top + ph - level / 5 * ph) + 0.5
            src(cr, th["axis"] if level == 0 else th["grid"])
            cr.move_to(left, y)
            cr.line_to(w - right, y)
            cr.stroke()
            if level:
                text(cr, self, str(level), left - 8, y, 9, th["muted"], ax=1, ay=0.5)
        band = pw / 7
        bw = min(24, band * 0.6)
        for i in range(7):
            cx = left + band * i + band / 2
            text(cr, self, WEEKDAYS[i], cx, h - bottom + 7, 9, th["muted"], ax=0.5)
            vals = by_day[i]
            if not vals:
                text(cr, self, "–", cx, top + ph - 6, 9.5, th["muted"], ax=0.5, ay=1)
                self.hits.append((cx - band / 2, top, band, ph, "%s: nothing logged" % WEEKDAYS[i]))
                continue
            avg = sum(vals) / len(vals)
            bh = avg / 5 * ph
            bar_up(cr, cx - bw / 2, top + ph - bh, bw, bh)
            src(cr, th["moods"][to_level(avg)])
            cr.fill()
            text(cr, self, "%.1f" % avg, cx, top + ph - bh - 4, 9.5, th["ink2"], ax=0.5, ay=1)
            self.hits.append((cx - band / 2, top, band, ph, "%s: average %.1f (%s) over %d day%s" % (
                WEEKDAYS[i], avg, MOOD_NAMES[to_level(avg)].lower(), len(vals),
                "" if len(vals) == 1 else "s")))


