# key: (title, unit, decimals, how a new value replaces an old one)
#   "max"  = daily totals that only grow (a partial day never beats a full one)
#   "last" = daily averages, newest value wins
METRICS = {
    "sleep_hours": ("Sleep", "h", 1, "max"),
    "steps": ("Steps", "", 0, "max"),
    "resting_hr": ("Resting heart rate", "bpm", 0, "last"),
    "heart_rate": ("Average heart rate", "bpm", 0, "last"),
    "hrv": ("Heart rate variability", "ms", 0, "last"),
    "active_energy": ("Active energy", "kcal", 0, "max"),
}
ALIASES = {
    "step": "steps", "steps": "steps", "step_count": "steps", "passi": "steps",
    "sleep": "sleep", "sleep_analysis": "sleep", "sonno": "sleep",
    "sleep_hours": "sleep_hours",
    "resting_hr": "resting_hr", "resting_heart_rate": "resting_hr", "rhr": "resting_hr",
    "heart_rate": "heart_rate", "hr": "heart_rate", "heart": "heart_rate",
    "hrv": "hrv", "heart_rate_variability": "hrv",
