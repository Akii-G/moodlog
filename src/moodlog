def _clean(text_):
    """One line of text for a spreadsheet cell."""
    return " / ".join(part.strip() for part in str(text_).splitlines() if part.strip())


def export_csv(path, store, events, health):
    """Write everything to one CSV file, one row per day, oldest first.

    Made to read well in a spreadsheet: plain-language headers with units, mood names
    next to the numbers, times in front of each mood and note, empty cells instead of
    zeros. Saved as UTF-8 with a BOM so accents show correctly when it is opened.
    Returns the number of days written.
    """
    days = set(store.days)
    days.update(e[0] for e in events.items)
    metrics = health.metrics()
    for metric in metrics:
        days.update(health.values.get(metric, {}))

    header = ["Date", "Weekday", "Mood", "Mood score (1–5)", "Moods during the day",
              "Notes", "Events", "Energy (1–5)", "Anxiety (1–5)"]
    for metric in metrics:
        title, unit, _dec, _how = metric_info(metric)
        unit = {"h": "hours"}.get(unit, unit)
        header.append("%s (%s)" % (title, unit) if unit else title)

    rows = []
    for day in sorted(days):
        items = store.entries(day)
        avg = store.day_avg(day)
        moods = []
        for time, mood, _note, *_ in items:
            if mood:
                moods.append("%s %s" % (time, MOOD_NAMES[mood]) if time else MOOD_NAMES[mood])
        notes = []
        for time, _mood, note, *_ in items:
            if note.strip():
                notes.append("%s: %s" % (time, _clean(note)) if time else _clean(note))
        evs = []
        for _d, kind, title, note, *_ in events.on(day):
            line = "%s: %s" % (EVENT_LABELS[kind], title)
            if note.strip():
                line += " (%s)" % _clean(note)
            evs.append(line)
        row = [day.isoformat(), WEEKDAYS_LONG[day.weekday()],
               MOOD_NAMES[to_level(avg)] if avg else "",
               ("%.1f" % avg).replace(".0", "") if avg else "",
               ", ".join(moods), " | ".join(notes), " | ".join(evs)]
        for index, _key, _name, _hint in SCALES:
            value = store.day_scale(day, index)
            row.append(("%.1f" % value).replace(".0", "") if value else "")
        for metric in metrics:
            value = health.values.get(metric, {}).get(day)
            row.append("" if value is None else format_value(metric, value, with_unit=False)
                       .replace(",", ""))
        rows.append(row)

    tmp = path + ".tmp"
    with open(tmp, "w", newline="", encoding="utf-8-sig") as f:
        w = csv.writer(f)
        w.writerow(header)
        w.writerows(rows)
    os.replace(tmp, path)
    return len(rows)


class ExportError(Exception):
    pass


def export_xlsx(path, store, events, health):
    """Write everything to a formatted spreadsheet (.xlsx) with a summary and charts.

    Sheets: Summary (key figures, mood counts and monthly averages with charts),
    Days (one row per day, like the CSV), Entries (every single mood), Events.
    Returns the number of days written.
    """
    try:
        from openpyxl import Workbook
        from openpyxl.chart import BarChart, LineChart, Reference
        from openpyxl.chart.marker import DataPoint
        from openpyxl.styles import Alignment, Border, PatternFill, Side
        from openpyxl.styles import Font as _Font
        from openpyxl.utils import get_column_letter
    except ImportError:
        raise ExportError("The spreadsheet export needs the python3-openpyxl package "
                          "(sudo apt install python3-openpyxl).")

    def Font(**kw):
        kw.setdefault("name", "Calibri")
        kw.setdefault("size", 11)
        return _Font(**kw)

    ink, muted, line = "1B1B1B", "77756F", "E1E0D9"
    head_fill = PatternFill("solid", fgColor="2F2F2D")
    head_font = Font(bold=True, color="FFFFFF")
    band_fill = PatternFill("solid", fgColor="F6F5F1")
    rule = Border(bottom=Side(style="thin", color=line))
    wrap = Alignment(wrap_text=True, vertical="top")
    top = Alignment(vertical="top")
    centre = Alignment(horizontal="center", vertical="top")

    def mood_style(cell, level):
        hex_ = MOOD_COLORS_LIGHT[level].lstrip("#").upper()
        cell.fill = PatternFill("solid", fgColor=hex_)
        cell.font = Font(bold=True, color=FACE_INK[level].lstrip("#").upper())

    def table(ws, headers, widths, first_row=1):
        for c, (name, width) in enumerate(zip(headers, widths), start=1):
            cell = ws.cell(row=first_row, column=c, value=name)
            cell.fill, cell.font = head_fill, head_font
            cell.alignment = Alignment(vertical="center", wrap_text=True)
            ws.column_dimensions[get_column_letter(c)].width = width
        ws.row_dimensions[first_row].height = 30

    def finish(ws, ncols, nrows, freeze="B2"):
        for r in range(2, nrows + 2):
            for c in range(1, ncols + 1):
                cell = ws.cell(row=r, column=c)
                cell.border = rule
                if cell.alignment is None or not cell.alignment.wrap_text:
                    if cell.alignment.horizontal != "center":
                        cell.alignment = top
        if nrows:
            ws.auto_filter.ref = "A1:%s%d" % (get_column_letter(ncols), nrows + 1)
        ws.freeze_panes = freeze

    wb = Workbook()
    try:
        wb._fonts[0] = Font()  # base font for cells without their own style
    except (AttributeError, IndexError):
        pass
    metrics = health.metrics()
    all_days = set(store.days)
    all_days.update(e[0] for e in events.items)
    for metric in metrics:
        all_days.update(health.values.get(metric, {}))
    all_days = sorted(all_days)

    # ---- Days
    days_ws = wb.active
    days_ws.title = "Days"
    headers = ["Date", "Weekday", "Mood", "Score (1–5)", "Moods during the day", "Notes",
               "Events"]
    widths = [13, 12, 10, 9, 30, 50, 36]
    headers += ["Energy (1–5)", "Anxiety (1–5)"]
    widths += [9, 9]
    formats = {}
    for metric in metrics:
        title, unit, decimals, _how = metric_info(metric)
        unit = {"h": "hours"}.get(unit, unit)
        headers.append("%s (%s)" % (title, unit) if unit else title)
        widths.append(14)
        formats[len(headers)] = "#,##0" if decimals == 0 else "0." + "0" * decimals
    table(days_ws, headers, widths)
    for r, day in enumerate(all_days, start=2):
        items = store.entries(day)
        avg = store.day_avg(day)
        moods = ["%s %s" % (t, MOOD_NAMES[m]) if t else MOOD_NAMES[m] for t, m, _n, *_ in items if m]
        notes = ["%s  %s" % (t, n.strip()) if t else n.strip() for t, _m, n, *_ in items if n.strip()]
        evs = []
        for _d, kind, title, note, *_ in events.on(day):
            evs.append("%s: %s%s" % (EVENT_LABELS[kind], title,
                                     (" — " + _clean(note)) if note.strip() else ""))
        values = [day, WEEKDAYS_LONG[day.weekday()], MOOD_NAMES[to_level(avg)] if avg else None,
                  round(avg, 1) if avg else None, "\n".join(moods) or None,
                  "\n".join(notes) or None, "\n".join(evs) or None]
        for index, _key, _name, _hint in SCALES:
            value = store.day_scale(day, index)
            values.append(round(value, 1) if value else None)
        for metric in metrics:
            values.append(health.values.get(metric, {}).get(day))
        for c, value in enumerate(values, start=1):
            cell = days_ws.cell(row=r, column=c, value=value)
            if c == 1:
                cell.number_format = "d mmm yyyy"
            elif c in (5, 6, 7):
                cell.alignment = wrap
            elif c in (8, 9):
                cell.number_format = "0.0"
                cell.alignment = centre
            elif c in formats:
                cell.number_format = formats[c]
            elif c == 4:
                cell.number_format = "0.0"
                cell.alignment = centre
        if avg:
            mood_style(days_ws.cell(row=r, column=3), to_level(avg))
            mood_style(days_ws.cell(row=r, column=4), to_level(avg))
            days_ws.cell(row=r, column=4).alignment = centre
        if evs:
            days_ws.cell(row=r, column=7).font = Font(bold=True)
        if day.weekday() >= 5:
            for c in (1, 2):
                days_ws.cell(row=r, column=c).fill = band_fill
    finish(days_ws, len(headers), len(all_days), freeze="C2")

    # ---- Entries
    ent_ws = wb.create_sheet("Entries")
    table(ent_ws, ["Date", "Time", "Mood", "Score", "Note", "Energy", "Anxiety"],
          [13, 8, 10, 7, 70, 9, 9])
    r = 1
    for day in sorted(store.days):
        for time, mood, note, energy, anxiety, *_ in store.entries(day):
            ent_ws.cell(row=r + 1, column=6, value=energy or None).alignment = centre
            ent_ws.cell(row=r + 1, column=7, value=anxiety or None).alignment = centre
            r += 1
            ent_ws.cell(row=r, column=1, value=day).number_format = "d mmm yyyy"
            ent_ws.cell(row=r, column=2, value=time or None).alignment = centre
            ent_ws.cell(row=r, column=3, value=MOOD_NAMES[mood] if mood else None)
            ent_ws.cell(row=r, column=4, value=mood or None).alignment = centre
            ent_ws.cell(row=r, column=5, value=note.strip() or None).alignment = wrap
            if mood:
                mood_style(ent_ws.cell(row=r, column=3), mood)
                mood_style(ent_ws.cell(row=r, column=4), mood)
                ent_ws.cell(row=r, column=4).alignment = centre
    finish(ent_ws, 7, r - 1)

    # ---- Events
    ev_ws = wb.create_sheet("Events")
    weeks = AROUND_DAYS // 7
    table(ev_ws, ["Date", "Type", "Title", "Details",
                  "Mood %d weeks before" % weeks, "Mood %d weeks after" % weeks],
          [13, 18, 32, 46, 13, 13])
    r = 1
    today = dt.date.today()
    for day, kind, title, note, *_ in events.items:
        r += 1
        ev_ws.cell(row=r, column=1, value=day).number_format = "d mmm yyyy"
        ev_ws.cell(row=r, column=2, value=EVENT_LABELS[kind])
        ev_ws.cell(row=r, column=3, value=title).font = Font(bold=True)
        ev_ws.cell(row=r, column=4, value=note.strip() or None).alignment = wrap
        if day <= today:
            (b, nb), (a, na), _complete = mood_around(store, day)
            for c, (avg, n) in ((5, (b, nb)), (6, (a, na))):
                if n >= 3:
                    cell = ev_ws.cell(row=r, column=c, value=round(avg, 1))
                    cell.number_format = "0.0"
                    mood_style(cell, to_level(avg))
                    cell.alignment = centre
    finish(ev_ws, 6, r - 1)

    # ---- Summary (first sheet)
    sm = wb.create_sheet("Summary", 0)
    sm.sheet_view.showGridLines = False
    sm.column_dimensions["A"].width = 26
    for col in "BCD":
        sm.column_dimensions[col].width = 14
    sm["A1"] = "Moodlog export"
    sm["A1"].font = Font(size=20, bold=True, color=ink)
    mood_days = store.moods()
    entries = [m for _d, _t, m in store.timed()]
    span = ""
    if all_days:
        span = " · data from %s to %s" % (all_days[0].strftime("%-d %B %Y"),
                                               all_days[-1].strftime("%-d %B %Y"))
    sm["A2"] = "Exported %s%s" % (today.strftime("%-d %B %Y"), span)
    sm["A2"].font = Font(color=muted)

    def figure(row, label, value, level=None, fmt=None):
        sm.cell(row=row, column=1, value=label).font = Font(color=muted)
        cell = sm.cell(row=row, column=2, value=value)
        cell.font = Font(bold=True, size=13)
        cell.alignment = Alignment(horizontal="left")
        if fmt:
            cell.number_format = fmt
        if level:
            mood_style(cell, level)
            cell.font = Font(bold=True, size=13, color=FACE_INK[level].lstrip("#").upper())

    avg_all = sum(m for _d, m in mood_days) / len(mood_days) if mood_days else 0
    day_avgs = [store.day_avg(d) for d, _m in mood_days]
    avg_all = sum(day_avgs) / len(day_avgs) if day_avgs else 0
    figure(4, "Days with a mood", len(mood_days))
    figure(5, "Moods logged", len(entries))
    figure(6, "Average mood (1–5)", round(avg_all, 1) if avg_all else "–",
           to_level(avg_all) if avg_all else None, "0.0")
    if entries:
        common = max(range(1, 6), key=lambda m: (entries.count(m), m))
        figure(7, "Most common mood", MOOD_NAMES[common], common)
    else:
        figure(7, "Most common mood", "–")
    figure(8, "Events logged", len(events.items))

    def section(row, title):
        cell = sm.cell(row=row, column=1, value=title)
        cell.font = Font(bold=True, size=13, color=ink)

    # mood counts + bar chart
    section(10, "How often you logged each mood")
    for c, name in enumerate(["Mood", "Times", "Share"], start=1):
        cell = sm.cell(row=11, column=c, value=name)
        cell.fill, cell.font = head_fill, head_font
    total = len(entries) or 1
    for i, level in enumerate(range(5, 0, -1)):
        row = 12 + i
        n = entries.count(level)
        mood_style(sm.cell(row=row, column=1, value=MOOD_NAMES[level]), level)
        sm.cell(row=row, column=2, value=n)
        share = sm.cell(row=row, column=3, value=n / total if entries else 0)
        share.number_format = "0%"
        for c in (1, 2, 3):
            sm.cell(row=row, column=c).border = rule
    if entries:
        chart = BarChart()
        chart.type = "bar"
        chart.title = "How often you logged each mood"
        chart.legend = None
        chart.add_data(Reference(sm, min_col=2, min_row=11, max_row=16), titles_from_data=True)
        chart.set_categories(Reference(sm, min_col=1, min_row=12, max_row=16))
        series = chart.series[0]
        for i, level in enumerate(range(5, 0, -1)):
            point = DataPoint(idx=i)
            point.graphicalProperties.solidFill = MOOD_COLORS_LIGHT[level].lstrip("#").upper()
            point.graphicalProperties.line.noFill = True
            series.dPt.append(point)
        chart.y_axis.majorGridlines = None
        chart.y_axis.scaling.min = 0
        chart.x_axis.scaling.orientation = "maxMin"  # Great at the top
        chart.y_axis.delete = False
        chart.x_axis.delete = False
        chart.height, chart.width = 7, 14
        sm.add_chart(chart, "F4")

    # monthly averages + line chart
    section(19, "Average mood by month")
    for c, name in enumerate(["Month", "Days logged", "Average (1–5)"], start=1):
        cell = sm.cell(row=20, column=c, value=name)
        cell.fill, cell.font = head_fill, head_font
    months = {}
    for day, _level in mood_days:
        months.setdefault((day.year, day.month), []).append(store.day_avg(day))
    row = 20
    for (year, month), vals in sorted(months.items()):
        row += 1
        avg = sum(vals) / len(vals)
        sm.cell(row=row, column=1, value="%s %d" % (MONTHS[month - 1], year))
        sm.cell(row=row, column=2, value=len(vals))
        cell = sm.cell(row=row, column=3, value=round(avg, 2))
        cell.number_format = "0.0"
        mood_style(cell, to_level(avg))
        for c in (1, 2, 3):
            sm.cell(row=row, column=c).border = rule
    if len(months) >= 2:
        chart = LineChart()
        chart.title = "Average mood by month"
        chart.legend = None
        chart.add_data(Reference(sm, min_col=3, min_row=20, max_row=row), titles_from_data=True)
        chart.set_categories(Reference(sm, min_col=1, min_row=21, max_row=row))
        series = chart.series[0]
        series.graphicalProperties.line.solidFill = "52514E"
        series.graphicalProperties.line.width = 28000
        series.marker.symbol = "circle"
        series.marker.size = 7
        series.marker.graphicalProperties.solidFill = "2A78D6"
        series.marker.graphicalProperties.line.solidFill = "2A78D6"
        series.smooth = False
        chart.y_axis.scaling.min, chart.y_axis.scaling.max = 1, 5
        chart.y_axis.majorUnit = 1
        chart.y_axis.delete = False
        chart.x_axis.delete = False
        chart.height, chart.width = 7, 14
        sm.add_chart(chart, "F19")

    # print each sheet to the page width; the wide day table in landscape
    for ws in wb.worksheets:
        ws.sheet_properties.pageSetUpPr.fitToPage = True
        ws.page_setup.fitToWidth = 1
        ws.page_setup.fitToHeight = 0
        ws.page_setup.orientation = "portrait" if ws is sm else "landscape"
        ws.print_options.horizontalCentered = True
        if ws is not sm:
            ws.print_title_rows = "1:1"
    for ws in (days_ws, ent_ws, ev_ws):
        for row in ws.iter_rows(min_row=2):
            for cell in row:
                if cell.font is not None and cell.font.name != "Calibri":
                    f = cell.font
                    cell.font = Font(bold=f.bold, color=f.color)
    tmp = path + ".tmp.xlsx"
    wb.save(tmp)
    os.replace(tmp, path)
    return len(all_days)


# ----------------------------------------------------------------- doctor report (PDF)

REPORT_INK = {"ink": "#1b1b1b", "ink2": "#4a4945", "muted": "#6d6b66", "grid": "#e3e2dc",
              "axis": "#c3c2b7", "tile": "#f4f3ef", "surface": "#ffffff", "health": "#1baf7a",
              "energy": "#b87c10", "anxiety": "#7b5ad6", "moods": MOOD_COLORS_LIGHT}


class _Pdf:
    """A4 pages drawn with cairo, text laid out by Pango at print resolution."""

    W, H, M = 595.28, 841.89, 42.0

    def __init__(self, path):
        import cairo
        self.surface = cairo.PDFSurface(path, self.W, self.H)
        try:
            self.surface.set_metadata(cairo.PDF_METADATA_TITLE, "Mood report")
            self.surface.set_metadata(cairo.PDF_METADATA_CREATOR, "Moodlog " + VERSION)
        except (AttributeError, Exception):
            pass
        self.cr = cairo.Context(self.surface)
        self.ctx = PangoCairo.create_context(self.cr)
        PangoCairo.context_set_resolution(self.ctx, 72)
        self.page = 1
        self.y = self.M
        self.bottom = self.H - self.M - 18

    def text(self, s, x, y, size=9, color="#1b1b1b", bold=False, width=None, align=0,
             measure=False, italic=False):
        layout = Pango.Layout.new(self.ctx)
        desc = Pango.FontDescription.from_string("Sans")
        desc.set_size(int(size * Pango.SCALE))
        if bold:
            desc.set_weight(Pango.Weight.BOLD)
        if italic:
            desc.set_style(Pango.Style.ITALIC)
        layout.set_font_description(desc)
        if width:
            layout.set_width(int(width * Pango.SCALE))
            layout.set_wrap(Pango.WrapMode.WORD_CHAR)
            layout.set_alignment((Pango.Alignment.LEFT, Pango.Alignment.CENTER,
                                  Pango.Alignment.RIGHT)[align])
        layout.set_text(s, -1)
        w, h = layout.get_pixel_size()
        if not measure:
            if not width and align:
                x -= w * (0.5 if align == 1 else 1.0)
            src(self.cr, color)
            self.cr.move_to(x, y)
            PangoCairo.show_layout(self.cr, layout)
        return w, h

    def footer(self):
        y = self.H - self.M + 4
        self.text("Made with Moodlog · self-reported data, not a medical record", self.M, y,
                  7.5, REPORT_INK["muted"])
        self.text("Page %d" % self.page, self.W - self.M, y, 7.5, REPORT_INK["muted"], align=2)

    def new_page(self):
        self.footer()
        self.cr.show_page()
        self.page += 1
        self.y = self.M

    def ensure(self, height):
        if self.y + height > self.bottom:
            self.new_page()
            return True
        return False

    def finish(self):
        self.footer()
        self.surface.finish()


def _avg(values):
    values = [v for v in values if v]
    return sum(values) / len(values) if values else 0.0


def export_report(path, store, events, health, start, end, include_notes=False,
                  include_health=True):
    """A printable summary for a doctor or therapist. Returns the number of pages."""
    ink = REPORT_INK
    pdf = _Pdf(path)
    cr, M, W = pdf.cr, pdf.M, pdf.W
    span = (end - start).days + 1
    days = [start + dt.timedelta(days=i) for i in range(span)]
    mood_days = [d for d in days if store.day_avg(d)]
    entries = [m for d, _t, m in store.timed(start, end)]
    evs = events.between(start, end)
    number = {id(e): i + 1 for i, e in enumerate(evs)}
    sleep = health.values.get("sleep_hours", {}) if include_health else {}
    rhr = health.values.get("resting_hr", {}) if include_health else {}
    steps = health.values.get("steps", {}) if include_health else {}
    sleep_days = [d for d in days if d in sleep]

    # ---- title
    pdf.text("Mood report", M, pdf.y, 20, ink["ink"], bold=True)
    pdf.y += 30
    sub = "%s – %s · %d days · made with Moodlog on %s" % (
        start.strftime("%-d %B %Y"), end.strftime("%-d %B %Y"), span,
        dt.date.today().strftime("%-d %B %Y"))
    pdf.text(sub, M, pdf.y, 9, ink["muted"])
    pdf.y += 24

    # ---- key numbers
    avg_mood = _avg(store.day_avg(d) for d in mood_days)
    tiles = [("Days with a mood", "%d of %d" % (len(mood_days), span), None),
             ("Average mood (1–5)", ("%.1f  %s" % (avg_mood, MOOD_NAMES[to_level(avg_mood)]))
              if avg_mood else "–", to_level(avg_mood) if avg_mood else None),
             ("Moods logged", str(len(entries)), None)]
    for index, key, name, _hint in SCALES:
        value = _avg(store.day_scale(d, index) for d in days)
        tiles.append(("Average %s (1–5)" % name.lower(),
                      ("%.1f  %s" % (value, SCALE_WORDS[key][to_level(value)])) if value else "–",
                      None))
    if sleep_days:
        tiles.append(("Average sleep", "%.1f h  (%d nights)" % (_avg(sleep[d] for d in sleep_days),
                                                             len(sleep_days)), None))
    elif rhr:
        vals = [rhr[d] for d in days if d in rhr]
        if vals:
            tiles.append(("Resting heart rate", "%.0f bpm" % _avg(vals), None))
    cols, gap, th = 3, 10, 50
    tw = (W - 2 * M - gap * (cols - 1)) / cols
    for i, (label, value, level) in enumerate(tiles):
        r, c = divmod(i, cols)
        x, y = M + c * (tw + gap), pdf.y + r * (th + gap)
        rounded_rect(cr, x, y, tw, th, 6)
        src(cr, ink["tile"])
        cr.fill()
        if level:
            rounded_rect(cr, x, y, 5, th, 2)
            src(cr, ink["moods"][level])
            cr.fill()
        pdf.text(label, x + 12, y + 8, 8, ink["muted"])
        pdf.text(value, x + 12, y + 22, 13, ink["ink"], bold=True)
    pdf.y += ((len(tiles) + cols - 1) // cols) * (th + gap) + 8

    # ---- mood mix (one stacked bar)
    if entries:
        pdf.text("How often each mood was logged", M, pdf.y, 10, ink["ink"], bold=True)
        pdf.y += 17
        total, x, bw, bh = len(entries), M, W - 2 * M, 14
        for level in range(1, 6):
            n = entries.count(level)
            if not n:
                continue
            seg = bw * n / total
            cr.rectangle(x, pdf.y, max(seg - 2, 1), bh)
            src(cr, ink["moods"][level])
            cr.fill()
            x += seg
        pdf.y += bh + 6
        x = M
        for level in range(1, 6):
            n = entries.count(level)
            cr.rectangle(x, pdf.y + 2, 8, 8)
            src(cr, ink["moods"][level])
            cr.fill()
            w, _h = pdf.text("%s %d%%" % (MOOD_NAMES[level], round(100 * n / total)), x + 12, pdf.y,
                             8.5, ink["ink2"])
            x += w + 26
        pdf.y += 22

    # ---- time charts
    weekly = span > 120

    def buckets(values):
        """{day: value} -> [(x position 0..1, value, label)] daily, or weekly averages."""
        out = []
        if not weekly:
            for i, d in enumerate(days):
                if d in values:
                    out.append((i, values[d], d.strftime("%-d %b")))
            return out, span
        weeks = {}
        for d, v in values.items():
            if start <= d <= end:
                weeks.setdefault((d - start).days // 7, []).append(v)
        return [(w, sum(v) / len(v), "") for w, v in sorted(weeks.items())], (span + 6) // 7

    def xpos(i, n, left, width):
        return left + (width / 2 if n <= 1 else 6 + i / (n - 1) * (width - 12))

    def axis_ticks(n, left, width, top, height):
        """Month or week tick labels under a chart, and the event lines with numbers."""
        cr.set_line_width(0.6)
        for i, d in enumerate(days):
            first = d.day == 1 or i == 0
            if span <= 45:
                show = d.weekday() == 0 or i == 0
                label = d.strftime("%-d %b")
            else:
                show = first
                label = d.strftime("%b %Y" if d.month == 1 or i == 0 else "%b")
            if show:
                slot = i if not weekly else i // 7
                x = xpos(slot, n, left, width)
                pdf.text(label, x, top + height + 4, 7.5, ink["muted"], align=1)
        for e in evs:
            i = (e[0] - start).days
            slot = i if not weekly else i // 7
