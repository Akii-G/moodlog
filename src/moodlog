    def refresh_events(self):
        child = self.events_list.get_first_child()
        while child:
            self.events_list.remove(child)
            child = self.events_list.get_first_child()
        for event in sorted(self.events.items, key=lambda e: e[0], reverse=True):
            day, kind, title, note = event[:4]
            row = Gtk.ListBoxRow()
            row.event = event
            row.set_tooltip_text("Click to edit")
            box = Gtk.Box(spacing=12)
            for side in ("top", "bottom", "start", "end"):
                getattr(box, "set_margin_" + side)(12)
            icon = EventIcon(32)
            icon.set_valign(Gtk.Align.START)
            box.append(icon)
            textbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, hexpand=True)
            when = Gtk.Label(label="%s · %s" % (day.strftime("%A, %-d %B %Y"),
                                                     EVENT_LABELS[kind]), xalign=0)
            when.add_css_class("dim-label")
            when.add_css_class("caption")
            head = Gtk.Label(label=title, xalign=0, wrap=True)
            head.add_css_class("heading")
            textbox.append(when)
            textbox.append(head)
            if note.strip():
                body = Gtk.Label(label=note.strip(), xalign=0, wrap=True)
                body.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
                textbox.append(body)
            summary = Gtk.Label(label=event_summary(self.store, event), xalign=0, wrap=True)
            summary.add_css_class("dim-label")
            summary.add_css_class("caption")
            textbox.append(summary)
            box.append(textbox)
            row.set_child(box)
            self.events_list.append(row)
        has = bool(self.events.items)
        self.events_list.set_visible(has)
        self.events_empty.set_visible(not has)


    def build_notes_page(self):
        self.search = Gtk.SearchEntry(placeholder_text="Search your notes")
        self.search.connect("search-changed", lambda *_: self.refresh_notes())
        self.notes_list = Gtk.ListBox()
        self.notes_list.set_selection_mode(Gtk.SelectionMode.NONE)
        self.notes_list.add_css_class("boxed-list")
        self.notes_list.connect("row-activated", self.on_note_row)
        self.notes_empty = Gtk.Label(wrap=True, justify=Gtk.Justification.CENTER)
        self.notes_empty.add_css_class("dim-label")
        self.notes_empty.set_margin_top(48)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        for side in ("top", "bottom", "start", "end"):
            getattr(col, "set_margin_" + side)(16)
        for wdg in (self.search, self.notes_list, self.notes_empty):
