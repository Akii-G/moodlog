def no_data(cr, widget, w, h, th):
    text(cr, widget, "No moods logged in this period yet", w / 2, h / 2, 10.5,
         th["muted"], ax=0.5, ay=0.5)


PLOT_LEFT, PLOT_RIGHT = 58, 18


def time_axis(win):
    """Shared x axis for the period on screen.

    Returns (slots, tick labels, date -> slot index, slot index -> description).
    A slot is a day in month view and a month in year / all-time view.
    """
    mode, cur = win.range_mode, win.cursor
    if mode == "month":
        n = calendar.monthrange(cur.year, cur.month)[1]
        labels = [(d - 1, str(d)) for d in range(1, n + 1) if d == 1 or d % 5 == 0]
        return (n, labels, lambda day: day.day - 1,
                lambda i: cur.replace(day=i + 1).strftime("%a %-d %b"))
    if mode == "year":
        months = [(cur.year, m) for m in range(1, 13)]
    else:
        firsts = [min(win.store.days)] if win.store.days else []
        firsts += [min(days) for days in win.health.values.values() if days]
        months = []
        if firsts:
            first, today = min(firsts), dt.date.today()
            y, m = first.year, first.month
            while (y, m) <= (today.year, today.month):
                months.append((y, m))
                y, m = (y + 1, 1) if m == 12 else (y, m + 1)
    index = {ym: i for i, ym in enumerate(months)}
    step = max(1, math.ceil(len(months) / 12))
    labels = []
    for i, (y, m) in enumerate(months):
        if i % step == 0:
            name = MONTHS[m - 1][:3]
            labels.append((i, name if mode == "year" else "%s %02d" % (name, y % 100)))
    return (len(months), labels, lambda day: index.get((day.year, day.month)),
            lambda i: "%s %d" % (MONTHS[months[i][1] - 1], months[i][0]))


def slot_x(i, n, w):
    pw = w - PLOT_LEFT - PLOT_RIGHT
    return PLOT_LEFT + (pw / 2 if n <= 1 else 8 + i / (n - 1) * (pw - 16))


def nice_step(span, target=3):
    raw = max(span, 1e-9) / target
    mag = 10 ** math.floor(math.log10(raw))
    for mult in (1, 2, 2.5, 5, 10):
        if raw <= mult * mag:
            return mult * mag
    return 10 * mag


class TrendChart(Canvas):
    """Mood over time. Daily points for a month, monthly averages otherwise."""

    def __init__(self, win):
        super().__init__(-1, 250)
        self.win = win
        self.set_hexpand(True)

    def draw(self, cr, w, h, th):
        win = self.win
        n, labels, slot, describe = time_axis(win)
        daily = win.range_mode == "month"
        buckets = {}
        for day, mood in win.period_moods():
            i = slot(day)
            if i is not None:
                buckets.setdefault(i, []).append((day, mood))
        pts = []
        for i in sorted(buckets):
            vals = [m for _d, m in buckets[i]]
            avg = sum(vals) / len(vals)
            if daily:
                day = buckets[i][0][0]
                avg = win.store.day_avg(day)  # exact average of that day's entries
                tip = win.store.describe_day(day, describe(i))
            else:
                tip = "%s — average %.1f (%s), %d day%s logged" % (
                    describe(i), avg, MOOD_NAMES[to_level(avg)].lower(), len(vals),
                    "" if len(vals) == 1 else "s")
            pts.append((i, avg, tip))

        top, bottom = 24, 30
        ph = h - top - bottom

        def ypos(v):
            return top + ph - (v - 1) / 4 * ph

        cr.set_line_width(1)
        for level in range(1, 6):
            y = round(ypos(level)) + 0.5
            src(cr, th["grid"])
            cr.move_to(PLOT_LEFT, y)
            cr.line_to(w - PLOT_RIGHT, y)
            cr.stroke()
            text(cr, self, MOOD_NAMES[level], PLOT_LEFT - 10, y, 9, th["muted"], ax=1, ay=0.5)
        draw_event_lines(self, cr, w, top, top + ph, th, n, slot)
        if not pts:
            no_data(cr, self, w + PLOT_LEFT - PLOT_RIGHT, h - bottom + top, th)
            return
        for i, label in labels:
            text(cr, self, label, slot_x(i, n, w), h - bottom + 9, 9, th["muted"], ax=0.5)
        # line: only joins neighbouring points, so skipped days show as gaps
        src(cr, th["ink2"])
        cr.set_line_width(2)
        cr.set_line_join(1)
        cr.set_line_cap(1)
        prev = None
        for i, v, _tip in pts:
            if prev is not None and i - prev == 1:
                cr.line_to(slot_x(i, n, w), ypos(v))
            else:
                cr.stroke()
                cr.move_to(slot_x(i, n, w), ypos(v))
            prev = i
        cr.stroke()
        for i, v, tip in pts:
            x, y = slot_x(i, n, w), ypos(v)
            src(cr, th["surface"])
            cr.arc(x, y, 7, 0, 2 * math.pi)
            cr.fill()
            src(cr, th["moods"][to_level(v)])
            cr.arc(x, y, 5, 0, 2 * math.pi)
            cr.fill()
            self.hits.append((x - 10, y - 10, 20, 20, tip))


class HealthChart(Canvas):
    """One health metric on the same time axis as the mood chart above it."""

    def __init__(self, win):
        super().__init__(-1, 190)
        self.win = win
        self.set_hexpand(True)

    def draw(self, cr, w, h, th):
        win, metric = self.win, self.win.health_metric
        if not metric:
            return
        title, _unit, _dec, how = metric_info(metric)
        n, labels, slot, describe = time_axis(win)
        start, end = win.period()
        buckets = {}
        for day, value in win.health.series(metric, start, end):
            i = slot(day)
            if i is not None:
                buckets.setdefault(i, []).append(value)
        if not buckets:
            text(cr, self, "No %s data in this period" % title.lower(), w / 2, h / 2, 10.5,
                 th["muted"], ax=0.5, ay=0.5)
            return
        daily = win.range_mode == "month"
        pts = [(i, sum(v) / len(v), len(v)) for i, v in sorted(buckets.items())]
        values = [v for _i, v, _c in pts]
        columns = how == "max"  # totals grow from zero; rates get a line
        lo = 0 if columns else min(values)
        step = nice_step(max(values) - lo if max(values) > lo else max(values) or 1)
        lo = 0 if columns else math.floor(lo / step) * step
        hi = math.ceil(max(values) / step) * step
        if hi <= lo:
            hi = lo + step
        top, bottom = 22, 28
        ph = h - top - bottom

        def ypos(v):
            return top + ph - (v - lo) / (hi - lo) * ph

        cr.set_line_width(1)
        tick = lo
        while tick <= hi + step / 1000:
            y = round(ypos(tick)) + 0.5
            src(cr, th["axis"] if (columns and tick == lo) else th["grid"])
            cr.move_to(PLOT_LEFT, y)
            cr.line_to(w - PLOT_RIGHT, y)
            cr.stroke()
            label = "{:,.{}f}".format(tick, 0 if step >= 1 else 1)
            text(cr, self, label, PLOT_LEFT - 10, y, 9, th["muted"], ax=1, ay=0.5)
            tick += step
        for i, label in labels:
            text(cr, self, label, slot_x(i, n, w), h - bottom + 8, 9, th["muted"], ax=0.5)
        draw_event_lines(self, cr, w, top, top + ph, th, n, slot)

        def tip(i, v, count):
            if daily:
                return "%s — %s" % (describe(i), format_value(metric, v))
            return "%s — average %s over %d day%s" % (
                describe(i), format_value(metric, v), count, "" if count == 1 else "s")

        if columns:
            gap = (w - PLOT_LEFT - PLOT_RIGHT - 16) / max(n - 1, 1)
            bw = max(3, min(24, gap - 2))
            for i, v, count in pts:
                x, bh = slot_x(i, n, w), max(1.5, ypos(lo) - ypos(v))
                bar_up(cr, x - bw / 2, ypos(lo) - bh, bw, bh)
                src(cr, th["health"])
                cr.fill()
                self.hits.append((x - max(bw, 16) / 2, top, max(bw, 16), ph, tip(i, v, count)))
            return
        src(cr, th["health"])
        cr.set_line_width(2)
        cr.set_line_join(1)
        cr.set_line_cap(1)
        prev = None
        for i, v, _c in pts:
            if prev is not None and i - prev == 1:
                cr.line_to(slot_x(i, n, w), ypos(v))
            else:
                cr.stroke()
                cr.move_to(slot_x(i, n, w), ypos(v))
            prev = i
        cr.stroke()
        for i, v, count in pts:
            x, y = slot_x(i, n, w), ypos(v)
            src(cr, th["surface"])
            cr.arc(x, y, 6, 0, 2 * math.pi)
            cr.fill()
            src(cr, th["health"])
            cr.arc(x, y, 4, 0, 2 * math.pi)
            cr.fill()
            self.hits.append((x - 10, y - 10, 20, 20, tip(i, v, count)))


