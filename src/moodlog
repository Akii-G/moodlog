_style_provider = {"css": None}


def apply_style(name):
    """Switch the look of every Moodlog window. 'default' removes the extra CSS."""
    STYLE["name"] = name if name in dict(STYLES) else "default"
    display = Gdk.Display.get_default()
    if display is None:
        return
    if _style_provider["css"] is not None:
        Gtk.StyleContext.remove_provider_for_display(display, _style_provider["css"])
        _style_provider["css"] = None
    if STYLE["name"] == "tahoe":
        provider = Gtk.CssProvider()
        css = _TAHOE_DARK if is_dark() else _TAHOE_LIGHT
        try:
            provider.load_from_string(css)  # GTK 4.12 and newer
        except AttributeError:
            provider.load_from_data(css.encode("utf-8"), -1)
        # Above the user's own ~/.config/gtk-4.0/gtk.css (where many system themes put
        # their rules), so a chosen style really applies. Only while Tahoe is selected.
        Gtk.StyleContext.add_provider_for_display(display, provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)
        _style_provider["css"] = provider


