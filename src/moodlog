    def update(self):
        current = data_dir()
        self.path_label.set_text(current)
        self.default_btn.set_visible(os.path.abspath(current) != os.path.abspath(default_data_dir()))
        found = conflict_files()
        self.conflict_box.set_visible(bool(found))
        if found:
            self.conflict_label.set_text(
                "%d conflict cop%s found from your sync app." % (len(found), "y" if len(found) == 1 else "ies"))

    def on_folder(self, folder):
        win = self.win
        win.flush()
        current = os.path.abspath(data_dir())
        folder = os.path.abspath(folder)
        if folder == current:
            return
        has_data = any(os.path.exists(os.path.join(folder, n)) for n in CONTENT_FILES)
        short = folder.replace(os.path.expanduser("~"), "~", 1)
        if not has_data:
            ConfirmWindow(self, "Move your data to %s?" % short, (
                "Your moods, events and health data are copied there, and Moodlog uses that "
                "folder from now on. The old folder keeps its copy."),
                [("Move here", lambda: self.switch(folder, copy=True), "suggested-action")]
            ).present()
            return
        ConfirmWindow(self, "%s already has Moodlog data" % short, (
            "Merge puts what is on this computer together with what is already there, which is "
            "what you want when setting up a second computer. Use that data switches to the "
            "folder as it is; the data here stays in the old folder."),
            [("Use that data", lambda: self.switch(folder), None),
             ("Merge", lambda: self.switch(folder, merge=True), "suggested-action")]).present()

    def switch(self, folder, copy=False, merge=False):
        import shutil
        win = self.win
        old = data_dir()
        try:
            os.makedirs(folder, exist_ok=True)
            if copy:
                for name in DATA_FILES:
                    src_path = os.path.join(old, name)
                    if os.path.exists(src_path):
                        shutil.copy2(src_path, os.path.join(folder, name))
            if merge:
                make_backup(os.path.join(folder, "backups", dt.datetime.now().strftime(
                    "before-merge-%Y%m%d-%H%M%S.zip")), folder)
                there = (Store(os.path.join(folder, "moods.csv")),
                         EventStore(os.path.join(folder, "events.csv")),
                         HealthStore(os.path.join(folder, "health.csv")))
                merge_folder_into(old, *there)
                for store in there:
                    store.save()
                if not os.path.exists(os.path.join(folder, "sync.json")) and \
                        os.path.exists(os.path.join(old, "sync.json")):
                    shutil.copy2(os.path.join(old, "sync.json"), os.path.join(folder, "sync.json"))
            cfg = load_config()
            if os.path.abspath(folder) == os.path.abspath(default_data_dir()):
                cfg.pop("data_dir", None)
            else:
                cfg["data_dir"] = folder
            save_config(cfg)
        except OSError as err:
            win.notify("Could not use that folder: %s" % (err.strerror or err))
            return
        systemctl("try-restart", SERVICE)  # the phone receiver reads the folder when it starts
        win.reload_data()
        self.update()
        win.notify("Moodlog now uses %s" % folder)


