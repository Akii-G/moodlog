        grid = Gtk.Grid(column_spacing=12, row_spacing=8)
        rows = [("Address", address), ("Token", cfg["token"])]
        if ip:
            rows.insert(1, ("If that fails", "http://%s:%d/health" % (ip, cfg["port"])))
        for r, (name, value) in enumerate(rows):
            key = Gtk.Label(label=name, xalign=0)
            key.add_css_class("dim-label")
            val = Gtk.Label(label=value, xalign=0, selectable=True, hexpand=True)
            val.set_wrap(True)
            val.set_wrap_mode(Pango.WrapMode.CHAR)
            copy = Gtk.Button.new_from_icon_name("edit-copy-symbolic")
            copy.set_tooltip_text("Copy")
            copy.add_css_class("flat")
            copy.connect("clicked", self.on_copy, value)
            grid.attach(key, 0, r, 1, 1)
            grid.attach(val, 1, r, 1, 1)
            grid.attach(copy, 2, r, 1, 1)
        col.append(card(grid))

        note = Gtk.Label(xalign=0, wrap=True, label=(
            "The token is a password: only requests that carry it are accepted. The receiver "
            "only takes data in over your local network and never sends any out. "
            "Health values are saved next to your moods, in health.csv."))
        note.add_css_class("dim-label")
        note.add_css_class("caption")
