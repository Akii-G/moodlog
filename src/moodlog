        lines = []
        if getattr(self, "error", ""):
            lines.append(self.error)
        lines.append("The receiver is running." if active else "The receiver is off.")
        try:
            with open(sync_status_path(), encoding="utf-8") as f:
                stamp, _, message = f.read().strip().partition("\n")
            lines.append("Last sync attempt %s. %s" % (stamp, message.replace("\n", " ")))
        except OSError:
            lines.append("Nothing received from the phone yet.")
        self.status.set_text("\n".join(lines))
        return True


