def version_key(version):
    try:
        return tuple(int(part) for part in str(version).split("."))
    except ValueError:
        return (0,)


def changelog_markdown():
    lines = ["# Changelog", "",
             "Moodlog for the PC and Moodlog for iPhone have their own version numbers. "
             "Each GitHub release is named after the PC version and includes both apps.", ""]
    for heading, log in (("Moodlog for the PC", CHANGELOG),
                         ("Moodlog for iPhone", IPHONE_CHANGELOG)):
        lines.append("## " + heading)
        lines.append("")
        for version, day, items in log:
            lines.append("### %s (%s)" % (version, day))
            lines.append("")
            lines.extend("- " + item for item in items)
            lines.append("")
    return "\n".join(lines)


