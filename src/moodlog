# ----------------------------------------------------------------- storage

def data_dir():
    base = os.environ.get("MOODLOG_DATA_DIR") or os.path.join(
        GLib.get_user_data_dir(), "moodlog")
    os.makedirs(base, exist_ok=True)
    return base


TIME_RE = re.compile(r"([01]\d|2[0-3]):[0-5]\d$")


def to_level(avg):
    """Average mood -> nearest whole level 1..5 (halves round up)."""
    return max(1, min(5, int(avg + 0.5)))


class Store:
    """All entries, kept in memory and mirrored to a CSV file.

    A day can hold several entries. Each entry is a list [time, mood, note]:
    time is "HH:MM" or "" (unknown), mood is 1-5 or 0 (note only).
    """

    def __init__(self):
        self.path = os.path.join(data_dir(), "moods.csv")
        self.days = {}  # date -> [[time, mood, note], ...] sorted by time
        self.load()

    def load(self):
        if not os.path.exists(self.path):
            return
        with open(self.path, newline="", encoding="utf-8") as f:
            for row in csv.DictReader(f):
                try:
                    day = dt.date.fromisoformat((row.get("date") or "").strip())
                    mood = int((row.get("mood") or "0").strip() or 0)
                except ValueError:
                    continue
                if not 1 <= mood <= 5:
                    mood = 0
                time = (row.get("time") or "").strip()
                if not TIME_RE.match(time):
                    time = ""
                note = row.get("note") or ""
                if mood or note.strip():
                    self.days.setdefault(day, []).append([time, mood, note])
        for items in self.days.values():
            items.sort(key=lambda e: e[0])

    def save(self):
        tmp = self.path + ".tmp"
        with open(tmp, "w", newline="", encoding="utf-8") as f:
            w = csv.writer(f)
            w.writerow(["date", "time", "mood", "note"])
            for day in sorted(self.days):
                for time, mood, note in self.days[day]:
                    w.writerow([day.isoformat(), time, mood or "", note])
        os.replace(tmp, self.path)

    def entries(self, day):
        return self.days.get(day, [])

    def add(self, day, time, mood, note):
        entry = [time if TIME_RE.match(time or "") else "", mood, note]
        items = self.days.setdefault(day, [])
        items.append(entry)
        items.sort(key=lambda e: e[0])
        return entry

    def resort(self, day):
        self.entries(day).sort(key=lambda e: e[0])

    def remove(self, day, entry):
        items = [e for e in self.entries(day) if e is not entry]
        if items:
            self.days[day] = items
        else:
            self.days.pop(day, None)

    def day_avg(self, day):
        vals = [e[1] for e in self.entries(day) if e[1]]
        return sum(vals) / len(vals) if vals else 0.0

    def day_level(self, day):
        """The day's mood as one level: the average of its entries, 0 if none."""
        avg = self.day_avg(day)
        return to_level(avg) if avg else 0

    def latest_mood(self, day):
        for entry in reversed(self.entries(day)):
            if entry[1]:
                return entry[1]
        return 0

    def has_note(self, day):
        return any(e[2].strip() for e in self.entries(day))

    def describe_day(self, day, title):
        """Tooltip text: the day's overall mood, then each entry on its own line."""
        items = self.entries(day)
        moods = [e[1] for e in items if e[1]]
        if not moods:
            head = "%s — no mood logged" % title
        elif len(moods) == 1:
            head = "%s — %s" % (title, MOOD_NAMES[moods[0]])
        else:
            avg = sum(moods) / len(moods)
            head = "%s — %s (average %.1f of %d entries)" % (
                title, MOOD_NAMES[to_level(avg)], avg, len(moods))
        lines = [head]
        for time, mood, note in items:
            if len(items) == 1 and not note.strip():
                break
            parts = [p for p in (time, MOOD_NAMES.get(mood, ""), note.strip()) if p]
            lines.append(" · ".join(parts))
        return "\n".join(lines)

    def moods(self, start=None, end=None):
        """Sorted (date, level) pairs, one per day that has a mood, within [start, end]."""
        out = []
        for day in sorted(self.days):
            if (start and day < start) or (end and day > end):
                continue
            level = self.day_level(day)
            if level:
                out.append((day, level))
        return out

    def timed(self, start=None, end=None):
        """Every entry with a mood as (date, time, mood), within [start, end]."""
        out = []
        for day in sorted(self.days):
            if (start and day < start) or (end and day > end):
                continue
            out.extend((day, e[0], e[1]) for e in self.days[day] if e[1])
        return out


