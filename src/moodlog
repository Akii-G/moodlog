        save.connect("clicked", self.on_save)
        buttons.append(cancel)
        buttons.append(save)
        col.append(buttons)
        self.set_child(col)
        self.preset(91)

    def preset(self, span):
        today = dt.date.today()
        if span == "year":
            start = dt.date(today.year, 1, 1)
        elif span == "all":
            known = list(self.win.store.days) + [e[0] for e in self.win.events.items]
            start = min(known) if known else today
        else:
            start = today - dt.timedelta(days=span - 1)
        self.start_entry.set_text(start.isoformat())
        self.end_entry.set_text(today.isoformat())
        self.error.set_visible(False)

    def dates(self):
        try:
            start = dt.date.fromisoformat(self.start_entry.get_text().strip())
            end = dt.date.fromisoformat(self.end_entry.get_text().strip())
        except ValueError:
            self.error.set_text("Write both dates as year-month-day, for example %s."
                                % dt.date.today().isoformat())
            self.error.set_visible(True)
            return None
        if end < start:
            self.error.set_text("The end date is before the start date.")
            self.error.set_visible(True)
            return None
        if (end - start).days > 3 * 366:
            self.error.set_text("Choose at most three years.")
            self.error.set_visible(True)
            return None
        self.error.set_visible(False)
        return start, end

    def on_save(self, *_):
        period = self.dates()
        if not period:
            return
        start, end = period
        name = "moodlog-report-%s-to-%s.pdf" % (start.isoformat(), end.isoformat())
        self.win._pick("Save the report", "save", lambda path: self.write(path, start, end), name)

    def write(self, path, start, end):
        if not path.lower().endswith(".pdf"):
            path += ".pdf"
        win = self.win
        win.flush()
        try:
            pages = export_report(path, win.store, win.events, win.health, start, end,
                                  include_notes=self.notes_check.get_active(),
                                  include_health=self.health_check.get_active())
        except (OSError, Exception) as err:
            self.error.set_text("Could not make the report: %s" % err)
            self.error.set_visible(True)
            return
        self.close()
        try:
            Gio.AppInfo.launch_default_for_uri(GLib.filename_to_uri(path, None), None)
        except GLib.Error:
            pass
        win.notify("Saved the report (%d page%s) as %s" % (pages, "" if pages == 1 else "s",
                                                           os.path.basename(path)))


