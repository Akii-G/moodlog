msgid_plural "%d items added."
msgstr[0] "%d elemento aggiunto."
msgstr[1] "%d elementi aggiunti."

#: src/moodlog:5256
msgid "The copies were moved to backups/merged-conflicts."
msgstr "Le copie sono state spostate in backups/merged-conflicts."

