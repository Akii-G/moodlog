msgid_plural "%d days ago"
msgstr[0] "%d giorno fa"
msgstr[1] "%d giorni fa"

msgid "%d day logged"
msgid_plural "%d days logged"
msgstr[0] "%d giorno registrato"
msgstr[1] "%d giorni registrati"

msgid "%d day logged, mostly %s."
msgid_plural "%d days logged, mostly %s."
msgstr[0] "%d giorno registrato, per lo più %s."
msgstr[1] "%d giorni registrati, per lo più %s."

msgid "%d event"
msgid_plural "%d events"
msgstr[0] "%d evento"
msgstr[1] "%d eventi"

msgid "%d thing to talk about"
msgid_plural "%d things to talk about"
msgstr[0] "%d cosa di cui parlare"
