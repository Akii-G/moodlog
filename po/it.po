msgid "%s came up %d time."
msgid_plural "%s came up %d times."
msgstr[0] "%s è comparsa %d volta."
msgstr[1] "%s è comparsa %d volte."

msgid "in %d day"
msgid_plural "in %d days"
msgstr[0] "tra %d giorno"
