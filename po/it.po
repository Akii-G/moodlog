msgid "%d day logged this month · average %.1f (%s)"
msgid_plural "%d days logged this month · average %.1f (%s)"
msgstr[0] "%d giorno registrato questo mese · media %.1f (%s)"
msgstr[1] "%d giorni registrati questo mese · media %.1f (%s)"

#: src/moodlog:5314
msgid "Nothing logged this month yet"
msgstr "Ancora niente registrato questo mese"

#: src/moodlog:5333
msgid "Mood day by day"
msgstr "Umore giorno per giorno"

#: src/moodlog:5355
